#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Fixed-point semantics (BASE...HEAD): using the recorded BASE (not
# HEAD~1) keeps multi-commit changes intact.
#
# Usage: diff-package BASE HEAD [OUTFILE]
# Default OUTFILE: diff-<base7>..<head7>.diff inside a fresh mktemp
# directory — never pollutes the target project's worktree or git status
# (the caller may override with any writable path).
# (named per range, so a re-review after fixes gets a distinct fresh file)
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: diff-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$(mktemp -d "${TMPDIR:-/tmp}/rime-review.XXXXXX")
  out="$dir/diff-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
