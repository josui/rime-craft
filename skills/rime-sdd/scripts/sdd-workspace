#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for its short-lived
# artifacts: task briefs, implementer reports, review packages, and the
# progress ledger. Print the directory's absolute path.
#
# Artifacts are grouped per rime task (.rime/sdd/<slug>/) so successive
# large-task runs in the same working tree never overwrite each other's
# briefs, reports, or progress ledger. SLUG is the rime task id without
# '#' (tasks.json "#0042" -> "0042"); a leading '#' is stripped if present.
# Missing slug is a hard error rather than a silent fall-back to a shared
# flat directory.
#
# The workspace hangs off the authoritative .rime/ directory, resolved through
# the shared resolver in hooks/scripts/rime-utils.sh (order defined in
# skills/rime-flow/data-contract.md). Resolving rather than using
# `git rev-parse --show-toplevel` matters in a linked worktree: toplevel points
# at the worktree, so artifacts would land in a *second*, empty .rime/ there —
# and that stray directory would then be picked up by the resolver on a later
# session, silently shadowing the real data.
#
# It deliberately stays in the working tree rather than under .git/. Note that
# .git/ IS writable by agents (verified 2026-07-30 with Write and Edit under
# permission mode acceptEdits; an earlier comment here claimed otherwise and was
# wrong). The real reason is visibility: editors hide .git/, and these artifacts
# — task briefs, implementer reports, review packages — are meant to be opened
# and read by a human.
#
# A self-ignoring .gitignore keeps the workspace out of `git status` and out of
# accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# Usage: sdd-workspace [SLUG]   (falls back to $SDD_SLUG)
set -euo pipefail

slug="${1:-${SDD_SLUG:-}}"
slug="${slug#\#}"
if [ -z "$slug" ]; then
  echo "sdd-workspace: missing slug — pass as arg or export SDD_SLUG (rime task id, e.g. 0042)" >&2
  exit 2
fi

. "$(cd "$(dirname "$0")/../../.." && pwd)/hooks/scripts/rime-utils.sh"

rime_dir=$(find_rime_dirs "$PWD" | head -1 || true)
if [ -z "$rime_dir" ]; then
  # Repo without rime initialized: create under the resolved base (main checkout side if in a worktree)
  rime_dir="$(rime_resolve_base "$PWD")/.rime"
fi
base="$rime_dir/sdd"
mkdir -p "$base/$slug"
printf '*\n' > "$base/.gitignore"
cd "$base/$slug" && pwd
